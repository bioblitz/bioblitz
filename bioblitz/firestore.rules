rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function notUpdatingElo() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['bElo', 'mElo', 'buElo', 'muElo', 'score']);
    }
    match /users/{userId} {
      allow read: if true; 
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && notUpdatingElo();

      match /friends/{friendId} {
        allow read: if true;
        allow write: if isSignedIn() && (
          isOwner(userId) || request.resource.data.uid == request.auth.uid
        );
      }

      match /ratingHistory/{historyId} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /sets/{setId} {
      allow read: if true;
      allow write: if false;

      match /questions/{questionId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /gameSubmissions/{submissionId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if true;
      allow update, delete: if false;
    }

    match /user_ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    match /users/{userId}/setsPlayed/{setId} {
      allow read: if true;
      // Usually written by Cloud Functions, but if client writes it:
      allow write: if isSignedIn() && isOwner(userId);
    }

    match /potdActivity/{potdId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.recipientUid;
      allow create: if isSignedIn();
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.challengerId || 
        request.auth.uid == resource.data.challengedId
      );
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.challengerId ||
        request.auth.uid == request.resource.data.challengedId
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.challengerId || 
        request.auth.uid == resource.data.challengedId
      );
    }

    match /search_index/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}